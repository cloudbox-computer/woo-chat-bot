# Copy to .env for local runs (bun dev). Deployed functions use the same names
# as Supabase secrets. Everything works with DATABASE=memory + AI_PROVIDER=mock.

# Database: memory (zero-setup local) or supabase
DATABASE=memory

# --- only needed when DATABASE=supabase --------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider: mock (offline demo) | gemini | openai ----------------------
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible endpoint base URL. Default is https://api.openai.com/v1.
# Point at any OpenAI-compatible server: https://generativelanguage.googleapis.com/v1beta/openai,
# https://openrouter.ai/api/v1, https://ollama.local/v1, an Azure OpenAI endpoint, etc.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini's OpenAI-compatible endpoint. Override only if you need a proxy.
GEMINI_BASE_URL=

# 32+ random characters; signs public-widget conversation sessions
CONVERSATION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Enterprise: >=32 random chars. Used to encrypt tenant integration secrets at rest.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
# Optional during key rotation. Comma-separate prior keys; remove after re-saving credentials.
INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
# Optional telemetry/error destinations are configured by your hosting platform.
SENTRY_DSN=
ENVIRONMENT=production
# Secret header used by scheduled worker/maintenance invocations.
WORKER_SECRET=replace-with-another-long-random-secret

# --- Stripe SaaS billing -----------------------------------------------------
# Secret key from Stripe Developers > API keys. Keep server-side only.
STRIPE_SECRET_KEY=
# Price IDs for recurring monthly GBP prices (£29 / £79 / £199).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# Signing secret for the Stripe webhook endpoint /functions/v1/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# Public dashboard origin used for Checkout success/cancel + Billing Portal return.
DASHBOARD_URL=https://dashboard-kappa-flax-30.vercel.app
# Optional: set true after Stripe Tax is configured on the Stripe account.
STRIPE_AUTOMATIC_TAX=false

# --- Phase 2 OAuth connector apps -------------------------------------------
# OAuth is optional. Manual credentials remain available. Configure only the
# providers you offer. CONNECTOR_OAUTH_CALLBACK_URL must exactly match the
# redirect URI registered with each provider.
CONNECTOR_OAUTH_CALLBACK_URL=https://YOUR-PROJECT.supabase.co/functions/v1/connector-oauth
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=
SALESFORCE_OAUTH_LOGIN_URL=https://login.salesforce.com
INTERCOM_OAUTH_CLIENT_ID=
INTERCOM_OAUTH_CLIENT_SECRET=
INTERCOM_OAUTH_REGION=us
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_SCOPES=crm.objects.contacts.read crm.objects.contacts.write
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_SCOPES=chat:write channels:read users:read
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=
HELPSCOUT_OAUTH_CLIENT_ID=
HELPSCOUT_OAUTH_CLIENT_SECRET=
