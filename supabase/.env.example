# Copy to .env for local runs (bun dev). Deployed functions use the same names
# as Supabase secrets. Everything works with DATABASE=memory + AI_PROVIDER=mock.

# Database: memory (zero-setup local) or supabase
DATABASE=memory

# --- only needed when DATABASE=supabase --------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider: mock (offline demo) | gemini | openai ----------------------
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible endpoint base URL. Default is https://api.openai.com/v1.
# Point at any OpenAI-compatible server: https://generativelanguage.googleapis.com/v1beta/openai,
# https://openrouter.ai/api/v1, https://ollama.local/v1, an Azure OpenAI endpoint, etc.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Gemini's OpenAI-compatible endpoint. Override only if you need a proxy.
GEMINI_BASE_URL=

# 32+ random characters; signs public-widget conversation sessions
CONVERSATION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Enterprise: >=32 random chars. Used to encrypt tenant integration secrets at rest.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-production-secret
# Optional telemetry/error destinations are configured by your hosting platform.
SENTRY_DSN=
ENVIRONMENT=production
# Secret header used by scheduled worker/maintenance invocations.
WORKER_SECRET=replace-with-another-long-random-secret
